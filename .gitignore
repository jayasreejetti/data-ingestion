*.log
*.db
*.db-journal
*.db-wal
*.sqlite3

# OS files
.DS_Store
Thumbs.db

# Keep directory structure
!data/staging/.gitkeep
!data/quarantine/.gitkeep
!data/processed/.gitkeep
